# ==============================================================================
# The Himachal Nomad - Environment Template (.env.example)
# Copy this file to .env and replace placeholders with your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Firebase Credentials & Database
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_analytics_measurement_id
VITE_FIREBASE_VAPID_KEY=your_cloud_messaging_vapid_key

# Aliases for Next.js / React setups (if applicable)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# 2. Master Admin Security & Operations
# ------------------------------------------------------------------------------
VITE_ADMIN_PASSKEY=963210
NEXT_PUBLIC_ADMIN_PASSKEY=963210

# ------------------------------------------------------------------------------
# 3. Direct Payments & Merchant Gateway (UPI / Razorpay)
# ------------------------------------------------------------------------------
VITE_UPI_VPA=your_upi_vpa@bank
VITE_MERCHANT_NAME=The Himachal Nomad
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

NEXT_PUBLIC_UPI_VPA=your_upi_vpa@bank
NEXT_PUBLIC_MERCHANT_NAME=The Himachal Nomad
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# ------------------------------------------------------------------------------
# 4. Direct Creator Contact & Customer Support
# ------------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER=919653240540
VITE_SUPPORT_EMAIL=monu@thehimachalnomad.com

# ------------------------------------------------------------------------------
# 5. External Telemetry & Weather Services
# ------------------------------------------------------------------------------
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

PORT=5000
