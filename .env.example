# ==============================================================================
# THE HIMACHAL NOMAD - GOOGLE FIREBASE AUTHENTICATION CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. In Firebase Console -> Authentication -> Sign-in method -> Enable "Phone"
# 3. In Project Settings -> General -> "Your apps" -> Add Web App
# 4. Copy the config values into a '.env' file in this directory:

VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id_here"
VITE_FIREBASE_APP_ID="your_app_id_here"

# (Optional) Server-side port
PORT=5000
